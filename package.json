{
  "name": "temp_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-env.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "worker:webhook-comparison": "tsx workers/comment-comparison.ts",
    "worker:webhook-comparison:health": "tsx workers/comment-comparison-healthcheck.ts",
