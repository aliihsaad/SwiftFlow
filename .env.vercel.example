# Vercel Environment Variables Configuration
# Copy these values to your Vercel project settings under Environment Variables

# ===================================
# REQUIRED - Supabase Configuration
# ===================================
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key
SUPABASE_SERVICE_KEY=eyJhbGc...your-service-role-key

# ===================================
# REQUIRED - Credential Security
# ===================================
# Generate independent values with: openssl rand -base64 48
# Keep the encryption key/version identical in Vercel and Supabase Function secrets.
APP_SECRETS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Keep v1 for the dual-reader rollout; switch to v2 only during the documented rotation.
APP_SECRETS_ENCRYPTION_VERSION=v1
# Rotation-only: old key retained while legacy records are upgraded.
APP_SECRETS_ENCRYPTION_KEY_PREVIOUS=
# Next.js only. Do not reuse the encryption key or Supabase service-role key.
DEVELOPER_API_KEY_PEPPER=replace-with-a-different-32-character-random-value
DEVELOPER_API_KEY_PEPPER_PREVIOUS=

# ===================================
# REQUIRED - Application URL
# ===================================
# Set this to your Vercel deployment URL
# Example: https://yourapp.vercel.app
# After deployment, update this with your actual URL and redeploy
NEXT_PUBLIC_APP_URL=https://yourapp.vercel.app

# ===================================
# REQUIRED - Team Invitation Email
# ===================================
# Create a Resend API key and verify the domain used by the sender address.
# These values are used by the Next.js app on Vercel, not Supabase Edge Functions.
RESEND_API_KEY=re_your-resend-api-key
# Example after domain verification: SwiftFlow <invites@example.com>
INVITE_EMAIL_FROM=replace-with-verified-sender
# Optional address that receives replies to workspace invitation emails.
INVITE_EMAIL_REPLY_TO=

# ===================================
# OPTIONAL - AI Provider (Gemini)
# ===================================
# Get your API key from: https://aistudio.google.com/app/apikey
# Note: You can also configure this via the dashboard Settings page after deployment
GEMINI_API_KEY=your-gemini-api-key

# ===================================
# REQUIRED - Instagram Integration
# ===================================
# Recommended: direct Instagram Login for comment automations.
# Get the Instagram App ID and Instagram App Secret from the Instagram product
# inside the Meta developer dashboard. Keep both server-only.
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# The default scopes already include basic account access, comments, and insights.
# Keep the messages scope for inbox, DM, and story-reply automations.
INSTAGRAM_OAUTH_EXTRA_SCOPES=instagram_business_manage_messages

# Shared webhook verification token used by the public callback handshake.
META_WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token

# ===================================
# REQUIRED - Release Channel
# ===================================
# Set review_phase_1 only on the Vercel environment used for Meta App Review.
# Use production_full for your normal full-product deployment.
APP_RELEASE_CHANNEL=production_full

# ===================================
# DEPLOYMENT CHECKLIST
# ===================================
# □ Copy all required variables to Vercel
# □ Deploy edge functions to Supabase
# □ Update NEXT_PUBLIC_APP_URL after first deployment
# □ Configure Supabase redirect URLs
# □ Configure Meta OAuth redirect URLs
# □ Test authentication flow
# □ Test AI features
# □ Test social media connections
