# SUPABASE
# Get these from your Supabase Project Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-semcret-service-role-key

# GOOGLE GEMINI AI
# Get your free API key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key

# UNSPLASH API (Optional - for free stock photos)
# Get your free API key here: https://unsplash.com/developers
# Create a Demo app to get 50 requests/hour
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# IMAGE GENERATION (Nano Banana)
# This is a placeholder for the demo. In a real app, use OpenAI (DALL-E) or Stability AI.
NANO_BANANA_API_KEY=your-nano-banana-key

# META / FACEBOOK APP (For Instagram & Facebook Integration)
# 1. Go to https://developers.facebook.com/ and create a "Business" app.
# 2. Add the "Facebook Login for Business" product.
# 3. In app Settings -> Basic, find your App ID and App Secret.
# 4. In Facebook Login -> Settings, add this to "Valid OAuth Redirect URIs":
#    http://localhost:3000/api/auth/meta/callback
#    https://your-app.vercel.app/api/auth/meta/callback
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# LEGACY: Facebook OAuth (deprecated - use META variables above)
FACEBOOK_CLIENT_ID=your-fb-app-id
FACEBOOK_CLIENT_SECRET=your-fb-app-secret

# APP URL
# The base URL of your application (used for redirects)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
