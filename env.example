# SUPABASE
# Get these from your Supabase Project Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-semcret-service-role-key

# CREDENTIAL SECURITY
# Generate independent values with: openssl rand -base64 48
# Keep the encryption key/version identical in Vercel and Supabase Function secrets.
APP_SECRETS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Keep v1 for the dual-reader rollout; switch to v2 only during the documented rotation.
APP_SECRETS_ENCRYPTION_VERSION=v1
# Rotation-only: old key retained while legacy records are upgraded.
APP_SECRETS_ENCRYPTION_KEY_PREVIOUS=
# Next.js only. New Developer API tokens are HMACed with this dedicated pepper.
DEVELOPER_API_KEY_PEPPER=replace-with-a-different-32-character-random-value
DEVELOPER_API_KEY_PEPPER_PREVIOUS=

# PROVIDER-NEUTRAL WEBHOOK COMPARISON WORKER
# Comparison mode only: it records matching decisions and never calls Meta.
DATABASE_URL=postgresql://swiftflow:change-me@localhost:5432/swiftflow
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000
# Set to require when the PostgreSQL endpoint requires TLS.
POSTGRES_SSL_MODE=
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
WEBHOOK_COMPARISON_WORKER_ID=
WEBHOOK_COMPARISON_BATCH_SIZE=10
WEBHOOK_COMPARISON_LEASE_SECONDS=60
WEBHOOK_COMPARISON_POLL_INTERVAL_MS=1000
WEBHOOK_COMPARISON_RETRY_BASE_MS=5000
WEBHOOK_COMPARISON_RETRY_MAX_MS=900000
# One-shot mode is intended for migration/deployment smoke checks only.
WEBHOOK_COMPARISON_RUN_ONCE=false

# OPENROUTER AI
# Get your API key here: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your-openrouter-key

# GOOGLE GEMINI AI
# Get your free API key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key

# AUTOMATION SIDE-EFFECT BUDGETS AND CIRCUIT BREAKERS
# Every guarded node consumes both its social-account and automation budget.
AUTOMATION_RUNTIME_GUARDS_REQUIRED=true
AUTOMATION_PROVIDER_SEND_ACCOUNT_BUDGET=60
AUTOMATION_PROVIDER_SEND_AUTOMATION_BUDGET=20
AUTOMATION_PROVIDER_SEND_BUDGET_WINDOW_SECONDS=3600
AUTOMATION_PROVIDER_SEND_CIRCUIT_FAILURE_THRESHOLD=5
AUTOMATION_PROVIDER_SEND_CIRCUIT_COOLDOWN_SECONDS=300
AUTOMATION_AI_ACCOUNT_BUDGET=120
AUTOMATION_AI_AUTOMATION_BUDGET=60
AUTOMATION_AI_BUDGET_WINDOW_SECONDS=3600
AUTOMATION_AI_CIRCUIT_FAILURE_THRESHOLD=5
AUTOMATION_AI_CIRCUIT_COOLDOWN_SECONDS=300

# IMAGE GENERATION (Nano Banana)
# This is a placeholder for the demo. In a real app, use OpenAI (DALL-E) or Stability AI.
NANO_BANANA_API_KEY=your-nano-banana-key

# META / FACEBOOK APP (For Instagram & Facebook Integration)
# 1. Go to https://developers.facebook.com/ and create a "Business" app.
# 2. Add the "Facebook Login for Business" product.
# 3. In app Settings -> Basic, find your App ID and App Secret.
# 4. In Facebook Login -> Settings, add this to "Valid OAuth Redirect URIs":
#    http://localhost:3000/api/auth/meta/callback
#    https://your-app.vercel.app/api/auth/meta/callback
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Instagram Login exposes a separate product secret in its API setup panel.
# Keep this distinct from the general Meta App Secret when both are available.
INSTAGRAM_APP_ID=your-instagram-login-app-id
INSTAGRAM_APP_SECRET=your-instagram-login-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
APP_RELEASE_CHANNEL=production_full
META_OAUTH_SCOPE_PROFILE=full

# APP URL
# The base URL of your application (used for redirects)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
