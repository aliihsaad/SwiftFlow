SWIFTFLOW_STAGING_POSTGRES_ADMIN_PASSWORD=replace-with-a-random-hex-secret
WEBHOOK_COMPARISON_DB_PASSWORD=replace-with-a-different-random-hex-secret
WEBHOOK_INGRESS_DB_PASSWORD=replace-with-a-third-random-hex-secret
SWIFTFLOW_WEBHOOK_COMPARISON_IMAGE=swiftflow/webhook-comparison:staging
WEBHOOK_COMPARISON_WORKER_ID=swiftflow-staging-comparison-1

# Staging-only Meta values. Instagram Login has a distinct product secret; keep
# both secrets so dashboard tests and real Instagram deliveries can be verified
# during the migration. Keep them synthetic until the callback is reviewed.
INSTAGRAM_APP_SECRET=replace-with-the-instagram-login-app-secret
META_APP_SECRET=replace-with-a-random-hex-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-hex-secret
WEBHOOK_INGRESS_PORT=8080
WEBHOOK_INGRESS_PATH=/webhooks/meta
