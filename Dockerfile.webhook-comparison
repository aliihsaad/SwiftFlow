FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS dependencies

WORKDIR /app

COPY workers/package.json workers/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS runtime

ENV NODE_ENV=production
WORKDIR /app

RUN addgroup --system swiftflow \
  && adduser --system --ingroup swiftflow --home /app swiftflow

COPY --from=dependencies --chown=swiftflow:swiftflow /app/node_modules ./node_modules
COPY --chown=swiftflow:swiftflow lib/database ./lib/database
COPY --chown=swiftflow:swiftflow lib/webhooks ./lib/webhooks
COPY --chown=swiftflow:swiftflow lib/automation ./lib/automation
COPY --chown=swiftflow:swiftflow workers ./workers

USER swiftflow

HEALTHCHECK --interval=10s --timeout=8s --start-period=5s --retries=3 \
  CMD ["node", "node_modules/tsx/dist/cli.mjs", "workers/comment-comparison-healthcheck.ts"]

ENTRYPOINT ["node", "node_modules/tsx/dist/cli.mjs"]
CMD ["workers/comment-comparison.ts"]
